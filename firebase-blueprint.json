{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile containing PII",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "globalRole": { "type": "string", "enum": ["owner", "admin", "moderator", "member", "visitor"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "globalRole", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public chat identity, CodyChat rank, cosmetics, and online presence without PII",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "globalRole": { "type": "string", "enum": ["owner", "admin", "moderator", "member", "visitor"] },
        "chatRank": {
          "type": "string",
          "enum": ["site_owner", "super_owner", "owner", "super_admin", "admin", "general_mod", "royal_vip", "silver_vip", "member", "guest"]
        },
        "avatarFrame": { "type": "string" },
        "nameplateStyle": { "type": "string" },
        "vipFamily": { "type": "string" },
        "coins": { "type": "integer" },
        "isMuted": { "type": "boolean" },
        "muteReason": { "type": "string" },
        "isBanned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "away", "offline"] },
        "isActive": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "globalRole", "status", "isActive", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Arabic chat room with role lists, mics toggle, and moderation state",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "permissionLevel": { "type": "string", "enum": ["PUBLIC", "APPROVAL_ONLY", "PRIVATE"] },
        "isLocked": { "type": "boolean" },
        "micsEnabled": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "admins": { "type": "array" },
        "moderators": { "type": "array" },
        "mutedUsers": { "type": "array" },
        "bannedUsers": { "type": "array" },
        "pinnedMessage": { "type": "string" },
        "pinnedMessageSender": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageSender": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "memberCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "ownerName", "isActive", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Live message inside a chat room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["owner", "admin", "moderator", "member", "visitor"] },
        "senderRank": {
          "type": "string",
          "enum": ["site_owner", "super_owner", "owner", "super_admin", "admin", "general_mod", "royal_vip", "silver_vip", "member", "guest"]
        },
        "senderAvatar": { "type": "string" },
        "senderAvatarUri": { "type": "string" },
        "senderFrame": { "type": "string" },
        "senderNameplate": { "type": "string" },
        "content": { "type": "string" },
        "imageUri": { "type": "string" },
        "voiceDurationSec": { "type": "integer" },
        "isAnnouncement": { "type": "boolean" },
        "replyToMessageId": { "type": "string" },
        "replyToSenderName": { "type": "string" },
        "replyToContent": { "type": "string" },
        "reactions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "senderId", "senderName", "content", "createdAt"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time typing indicator per user in a room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "userId", "displayName", "updatedAt"]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "Private 1-on-1 text chat thread",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantAvatars": { "type": "object" },
        "lastMessageText": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private 1-on-1 text message",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "participantIds": { "type": "array" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "content": { "type": "string" },
        "replyToMessageId": { "type": "string" },
        "replyToSenderName": { "type": "string" },
        "replyToContent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "participantIds", "senderId", "senderName", "content", "createdAt"]
    },
    "BanRecord": {
      "title": "BanRecord",
      "description": "Moderation ban record for room or global ban",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string" },
        "targetName": { "type": "string" },
        "reason": { "type": "string" },
        "isPermanent": { "type": "boolean" },
        "expiresAtMillis": { "type": "integer" },
        "bannedByUid": { "type": "string" },
        "bannedByName": { "type": "string" },
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "isGlobal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUid", "targetName", "reason", "isPermanent", "expiresAtMillis", "bannedByUid", "bannedByName", "isGlobal", "createdAt"]
    },
    "WallPost": {
      "title": "WallPost",
      "description": "Social wall post shared among chat community members",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRank": { "type": "string" },
        "authorEmoji": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "integer" },
        "likedBy": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "authorRank", "content", "likes", "isActive", "createdAt", "updatedAt"]
    },
    "ChatNotification": {
      "title": "ChatNotification",
      "description": "Announcement or moderation alert notification",
      "type": "object",
      "properties": {
        "audience": { "type": "string" },
        "createdByUid": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["audience", "createdByUid", "title", "body", "createdAt", "updatedAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Abuse report submitted by a user to admins",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string" },
        "reporterName": { "type": "string" },
        "targetName": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "reporterName", "targetName", "reason", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile with PII (owner/admin access only)"
    },
    "/public_profiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Public chat directory & online presence without PII"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Public and private chat rooms"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Real-time messages in a room"
    },
    "/rooms/{roomId}/typing/{userId}": {
      "schema": "TypingStatus",
      "description": "Live typing indicator for a room"
    },
    "/direct_chats/{chatId}": {
      "schema": "DirectChat",
      "description": "Private 1-on-1 text chat metadata"
    },
    "/direct_chats/{chatId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Private 1-on-1 messages"
    },
    "/bans/{banId}": {
      "schema": "BanRecord",
      "description": "Active room and global bans"
    },
    "/wall_posts/{postId}": {
      "schema": "WallPost",
      "description": "Community wall posts"
    },
    "/notifications/{notifId}": {
      "schema": "ChatNotification",
      "description": "System and user-targeted notifications"
    },
    "/reports/{reportId}": {
      "schema": "UserReport",
      "description": "Moderation reports submitted by signed-in users"
    }
  }
}
